# Server only. Use different database, auth project, API key, webhook secret and plans per environment.
DATABASE_URL=postgresql://SERVER_ROLE:SECRET@HOST:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
WHOP_ENVIRONMENT=sandbox
WHOP_COMPANY_ID=biz_REPLACE
WHOP_API_KEY=SERVER_ONLY_REPLACE
WHOP_WEBHOOK_SECRET=ws_SERVER_ONLY_REPLACE
WHOP_PLAN_ESSENTIAL=plan_REPLACE1
WHOP_PLAN_PROFESSIONAL=plan_REPLACE2
WHOP_PLAN_INTENSIVE=plan_REPLACE3
WHOP_PLAN_EXTRA=plan_REPLACE4
BILLING_RETURN_URL=https://YOUR_DOMAIN/billing-return
BILLING_SALES_ENABLED=false
# Explicit selected arrangement, requiring matching dashboard configuration.
# Whop remittance coverage is US/EU/UK; other jurisdictions still require seller review.
WHOP_TAX_ARRANGEMENT=whop_collects_and_remits
WHOP_TAX_BEHAVIOR=exclusive
# Production gates: references to independently verified evidence, never secrets.
WHOP_MERCHANT_APPROVAL_REFERENCE=
WHOP_BIH_PAYOUT_VERIFIED_REFERENCE=
WHOP_TAX_SETUP_VERIFIED_REFERENCE=
WHOP_SANDBOX_REPORT_REFERENCE=
MANAGED_METERING_RELEASE_REFERENCE=
PORT=8787
BIND_HOST=127.0.0.1
# Managed direct-stream INTERNAL BETA only. Public admission is not implemented/enabled.
MANAGED_INTERNAL_BETA=false
MANAGED_BETA_ACCOUNT_IDS=
MANAGED_MAX_SESSION_SECONDS=1800
SONIOX_API_KEY=
SONIOX_PROJECT_REF=
SONIOX_REGION=us
